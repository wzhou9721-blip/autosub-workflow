GLADIA_API_KEY=your_gladia_api_key_here

# Optional: limit source language detection for better latency/accuracy, e.g. en or zh
GLADIA_SOURCE_LANGUAGES=en

# Gladia uses ISO 639-1 language codes. "zh" is the supported Chinese target code.
GLADIA_TARGET_LANGUAGE=zh
GLADIA_TRANSLATION_MODEL=enhanced
GLADIA_TRANSLATION_MATCH_ORIGINAL_UTTERANCES=true
GLADIA_TRANSLATION_LIPSYNC=false
GLADIA_TRANSLATION_CONTEXT_ADAPTATION=true
GLADIA_TRANSLATION_CONTEXT=
GLADIA_TRANSLATION_INFORMAL=false

# Optional: external translation API (OpenAI-compatible).
# When all three values below are filled, Gladia translation will be disabled
# and final English transcripts will be translated after the session ends.
TRANSLATION_API_KEY=your_translation_api_key_here
TRANSLATION_BASE_URL=https://your-openai-compatible-base-url/v1
TRANSLATION_MODEL=your_translation_model
TRANSLATION_FREQUENCY=1
TRANSLATION_BATCH_SIZE=20
TRANSLATION_REQUEST_TIMEOUT_SECONDS=60

# Subtitle-oriented defaults
GLADIA_ENDPOINTING=0.05
GLADIA_AUDIO_ENHANCER=false
GLADIA_SPEECH_THRESHOLD=0.6
GLADIA_SAMPLE_RATE=16000

# Audio settings
CAPTURE_SAMPLE_RATE=48000
CAPTURE_CHANNELS=2
CHUNK_DURATION_MS=100

# Result polling
RESULT_POLL_INTERVAL_SECONDS=2
RESULT_POLL_TIMEOUT_SECONDS=120
